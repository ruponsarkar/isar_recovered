    \"<span class=sf-dump-key>title</span>\" => \"<span class=sf-dump-str title=\"17 characters\">About the Journal</span>\"
    \"<span class=sf-dump-key>slug</span>\" => \"<span class=sf-dump-str title=\"5 characters\">about</span>\"
    \"<span class=sf-dump-key>type</span>\" => \"<span class=sf-dump-str title=\"7 characters\">content</span>\"
