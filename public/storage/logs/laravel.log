    \"<span class=sf-dump-key>j_name</span>\" => \"<span class=sf-dump-str title=\"39 characters\">ISAR Journal of Agriculture and Biology</span>\"
    \"<span class=sf-dump-key>slug</span>\" => \"<span class=sf-dump-str title=\"7 characters\">isarjab</span>\"
    \"<span class=sf-dump-key>abbr_title</span>\" => \"<span class=sf-dump-str title=\"16 characters\">ISAR J Agri Biol</span>\"
