  <span class=sf-dump-index>5</span> => <span class=sf-dump-note>array:15</span> [<samp data-depth=2 class=sf-dump-compact>
    \"<span class=sf-dump-key>id</span>\" => <span class=sf-dump-num>10</span>
    \"<span class=sf-dump-key>journal_id</span>\" => <span class=sf-dump-num>1</span>
