    \"<span class=sf-dump-key>title</span>\" => \"<span class=sf-dump-str title=\"15 characters\">Publication Fee</span>\"
    \"<span class=sf-dump-key>slug</span>\" => \"<span class=sf-dump-str title=\"15 characters\">publication-fee</span>\"
