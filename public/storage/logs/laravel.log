    \"<span class=sf-dump-key>title</span>\" => \"<span class=sf-dump-str title=\"17 characters\">Author Guidelines</span>\"
    \"<span class=sf-dump-key>slug</span>\" => \"<span class=sf-dump-str title=\"17 characters\">author-guidelines</span>\"
    \"<span class=sf-dump-key>type</span>\" => \"<span class=sf-dump-str title=\"7 characters\">content</span>\"
