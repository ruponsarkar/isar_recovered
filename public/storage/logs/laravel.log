  <span class=sf-dump-index>4</span> => <span class=sf-dump-note>array:22</span> [<samp data-depth=2 class=sf-dump-compact>
    \"<span class=sf-dump-key>id</span>\" => <span class=sf-dump-num>1522</span>
    \"<span class=sf-dump-key>name</span>\" => \"<span class=sf-dump-str title=\"99 characters\">URDU TRANSLATION AND CROSS-CULTURAL VALIDATION OF THE WAY FINDING QUESTIONNAIRE FOR STROKE PATIENTS</span>\"
    \"<span class=sf-dump-key>slug</span>\" => \"<span class=sf-dump-str title=\"100 characters\">URDU-TRANSLATION-AND-CROSS-CULTURAL-VALIDATION-OF-THE-WAY-FINDING-QUESTIONNAIRE-FOR-STROCKE-PATIENTS</span>\"
    \"<span class=sf-dump-key>aname</span>\" => \"<span class=sf-dump-str title=\"76 characters\">Suhair Asif*, Arida Mushtaq, Dr. Eram Aslam, Hamna Tanveer, Dr. Maryam Nasim</span>\"
    \"<span class=sf-dump-key>abstract</span>\" => \"\"\"
      <span class=sf-dump-str title=\"4720 characters\">&lt;p class=&quot;MsoNormal&quot; style=&quot;line-height: 115%; font-family: Calibri, &amp;quot;sans-serif&amp;quot;; margin: 8px 0in 0px; text-align: justify; font-size: 15px;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;; color: black;&quot;&gt;Background:<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        &lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;; color: black;&quot;&gt;Spatial navigation is integral to independence and quality of<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        life; its impairment is a recognized but frequently underassessed sequela of<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        stroke. The Way Finding Questionnaire (WFQ) is a validated 22-item self-report<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        instrument that evaluates navigational ability across three domains Navigation<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        and Orientation, Spatial Anxiety, and Distance Estimation and has demonstrated<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        strong psychometric properties in Western populations. No Urdu-language version<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        existed prior to this study, limiting its applicability within Pakistan&#039;s<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        predominantly Urdu-speaking population.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">&lt;p class=&quot;MsoNormal&quot; style=&quot;line-height: 115%; font-family: Calibri, &amp;quot;sans-serif&amp;quot;; margin: 8px 0in 0px; text-align: justify; font-size: 15px;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;; color: black;&quot;&gt;Objective:<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        &lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;; color: black;&quot;&gt;To translate the original English WFQ into Urdu and to evaluate<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        the validity and reliability of the resulting Urdu version (WFQ-U) in patients<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        with stroke.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">&lt;p class=&quot;MsoNormal&quot; style=&quot;line-height: 115%; font-family: Calibri, &amp;quot;sans-serif&amp;quot;; margin: 8px 0in 0px; text-align: justify; font-size: 15px;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;; color: black;&quot;&gt;Methods:<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        &lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;; color: black;&quot;&gt;A cross-cultural validation study was conducted at Jinnah Hospital,<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        Lahore, enrolling 70 stroke patients aged 18&#8211;65 years via convenience sampling.<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        The translation followed the six-stage Beaton et al. framework, encompassing<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        forward translation, synthesis, backward translation, expert committee review,<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        pilot testing, and documentation submission. Reliability was assessed using<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        Cronbach&#039;s alpha (internal consistency) and the intraclass correlation<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        coefficient (ICC; test-retest reliability, one-week interval). Content validity<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        was determined using the Content Validity Index (CVI). Concurrent validity was<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        examined through Pearson correlation with the Floor Maze Test (FMT).&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">&lt;p class=&quot;MsoNormal&quot; style=&quot;line-height: 115%; font-family: Calibri, &amp;quot;sans-serif&amp;quot;; margin: 8px 0in 0px; text-align: justify; font-size: 15px;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;; color: black;&quot;&gt;Results:<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        &lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;; color: black;&quot;&gt;The sample comprised 33 males (47.1%) and 37 females (52.9%), with<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        a mean age of 46.91 &#177; 9.90 years. The mean total WFQ-U score was 75.29 &#177; 11.67.<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        Cronbach&#039;s alpha was 0.987 (Day 1) and 0.977 (Day 3), indicating excellent<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        internal consistency. The ICC for test-retest reliability was 0.825 (95% CI:<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        0.780&#8211;0.865). The overall CVI was 0.825. Pearson correlation between the WFQ-U<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        and the FMT was r = 0.929 (p &amp;lt; 0.05), demonstrating strong concurrent<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        validity.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">&lt;p class=&quot;MsoNormal&quot; style=&quot;line-height: 115%; font-family: Calibri, &amp;quot;sans-serif&amp;quot;; margin: 8px 0in 0px; text-align: justify; font-size: 15px;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;; color: black;&quot;&gt;Conclusion:<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        &lt;/span&gt;&lt;/strong&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;; color: black;&quot;&gt;The WFQ-U is a valid and reliable patient-reported outcome measure<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        for assessing navigational ability in Urdu-speaking stroke patients. Its<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"4720 characters\">        adoption in Pakistani clinical and research settings is recommended&lt;/span&gt;&lt;span style=&quot;line-height: 115%; font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;;&quot;&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</span>
      \"\"\"
    \"<span class=sf-dump-key>designation</span>\" => \"<span class=sf-dump-str title=\"150 characters\">MSc Physical Therapy (Neuromuscular), Riphah College of Rehabilitation &amp; Allied Health Sciences, Riphah International University, Islamabad, Pakistan.</span>\"
