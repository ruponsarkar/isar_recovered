      <span class=sf-dump-str title=\"2602 characters\">        The journal publishes research articles, reviews, and short communications in<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">        the following areas:&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">&lt;p class=&quot;MsoNormal&quot; style=&quot;margin: 0in 0in 13px; line-height: 115%; font-size: 15px; font-family: Calibri, &amp;quot;sans-serif&amp;quot;;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;, &amp;quot;serif&amp;quot;;&quot;&gt;Engineering,<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">        Science and Technology, Aeronautical Engineering, Biosystems Engineering, Civil<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">        Engineering, Computer Engineering, Electrical Engineering, Engineering<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">        Mathematics, Material Science, Mechanical Engineering, Software Engineering,<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">        Telecommunication Engineering, Agriculture Engineering, Biomedical Engineering,<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">        Biotechnology, Chemical Engineering, Communication Engineering, Construction<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">        Engineering, Earth Science, Electromechanical Engineering, Engineering<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">        Chemistry, Engineering Physics, Environmental Engineering, Food Engineering,<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">        Geological Engineering, Manufacturing Technology, Nanotechnology, Nuclear<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">        Engineering, Ocean Engineering, Oil &amp;amp; Petroleum Engineering, Structural<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"2602 characters\">        Engineering.&lt;/span&gt;&lt;/p&gt;</span>
      \"\"\"
