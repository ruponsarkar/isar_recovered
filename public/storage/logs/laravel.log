  <span class=sf-dump-index>21</span> => <span class=sf-dump-note>array:15</span> [<samp data-depth=2 class=sf-dump-compact>
    \"<span class=sf-dump-key>id</span>\" => <span class=sf-dump-num>22</span>
    \"<span class=sf-dump-key>journal_id</span>\" => <span class=sf-dump-num>1</span>
