    \"<span class=sf-dump-key>slug</span>\" => \"<span class=sf-dump-str title=\"11 characters\">open-access</span>\"
    \"<span class=sf-dump-key>type</span>\" => \"<span class=sf-dump-str title=\"7 characters\">content</span>\"
