    \"<span class=sf-dump-key>content</span>\" => \"\"\"
      <span class=sf-dump-str title=\"2645 characters\">&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span&gt;The &lt;em&gt;ISAR Journal of Arts, Humanities and Social Sciences&lt;/em&gt; is a journal that<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        supports itself and does not obtain funding from any government or<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        institutional bodies. As a result, the journal is completely financed by the<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        Article Processing Charges (APCs) paid by the authors. These charges pay for<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        the expenses associated with manuscript processing, peer review, editing,<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        formatting, online publication, website maintenance, and other related<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        services.&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span&gt;Note that an article submission fee<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        is not required.&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span&gt;Only after their manuscript has<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        been accepted for publication do authors have to pay the processing fee.&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">&lt;p class=&quot;MsoNormal&quot;&gt;&lt;strong&gt;&lt;span&gt;Publication Charges&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span&gt;Indian: INR 12000&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span&gt;Foreign: USD 200$ per accepted<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        manuscript&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span&gt;<span class=sf-dump-default>\\u{A0}</span>&lt;/span&gt;&lt;br&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">&lt;p class=&quot;MsoNormal&quot;&gt;&lt;strong&gt;&lt;span&gt;The details regarding payment will be included in the letter of<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">            acceptance.&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">&lt;p class=&quot;MsoNormal&quot;&gt;&lt;strong&gt;&lt;span&gt;Policy on waivers:&lt;/span&gt;&lt;/strong&gt;&lt;span&gt; &lt;em&gt;ISAR Journal of<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">            Arts, Humanities and Social Sciences &lt;/em&gt;is determined to promote equitable<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        access to the publication of scholarly work. In accordance with international<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        best practices, the corresponding author from a country which the World Bank<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        has classified as being a low-income or lower-middle-income economy, or one who<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        is able to show real financial difficulty, may apply for a partial waiver<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        covering up to 50% of the Article Processing Charges.&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span&gt;Waiver requests must be submitted<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        at the same time as the manuscript and are treated in a confidential manner.<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        The decisions regarding waivers are entirely independent of the editorial and<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        peer-review process, which depends solely on academic merit.&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">&lt;p class=&quot;MsoNormal&quot;&gt;&lt;strong&gt;&lt;span&gt;Refund Policy:&lt;/span&gt;&lt;/strong&gt;&lt;span&gt; The Article Processing Charges (APCs) will not be<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\">        refundable in any situation after an article has been accepted and published.&lt;/span&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
      <span class=sf-dump-str title=\"2645 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>
