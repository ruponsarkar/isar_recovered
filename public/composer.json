{
  "name": "isar/backend",
  "type": "project",
  "description": "ISAR Publisher API.",
  "require": {
    "php": "^8.0.2",
    "laravel/framework": "9.52.16",
    "laravel/sanctum": "3.3.3",
    "razorpay/razorpay": "2.9.1",
    "tymon/jwt-auth": "2.0.0"
  },
  "require-dev": {
    "fakerphp/faker": "1.23.1",
    "nunomaduro/collision": "6.4.0",
    "phpunit/phpunit": "9.6.16",
    "spatie/laravel-ignition": "1.6.4"
  },
  "autoload": {
    "files": ["app/helpers.php"],
    "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
  },
  "autoload-dev": {
    "psr-4": { "Tests\\": "tests/" }
  },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
  },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true },
  "minimum-stability": "dev",
  "prefer-stable": true
}
